{$SITE_ADDRESS}

encode gzip

# Ограничение доступа по IP — блокирует ВСЕ страницы сервиса,
# включая форму логина и саму SPA-оболочку, не только вызовы API: в проде
# Django не отдаёт фронтенд напрямую (это делает контейнер frontend), поэтому
# проверка должна стоять здесь, перед всеми handle-блоками, а не в Django-
# миддлваре. Пустой allowlist (по умолчанию) — эндпоинт всегда пропускает.
# Самоблокировка администратора снимается на сервере: `docker compose exec
# backend python manage.py reset_ip_allowlist`.
forward_auth backend:8000 {
	uri /api/internal/ip-check/
}

handle /api/* {
	reverse_proxy backend:8000
}

# B9: служебная Django-админка. Доступ гейтит сам Django
# (core.middleware.AdminAccessGateMiddleware — флаг в Настройках + отдельный
# IP-список), поэтому здесь просто проксируем на backend; статику админки отдаёт
# общий блок /static/* ниже. Матчим и путь без завершающего слэша — иначе
# `/django_admin` уйдёт в SPA-fallback; со слэшем Django добавит его редиректом.
@django_admin path /django_admin /django_admin/*
handle @django_admin {
	reverse_proxy backend:8000
}

# Резервные копии содержат хэши паролей и все бизнес-данные —
# отдаются только через авторизованный /api/backup/<id>/download/,
# не статикой. Блок должен идти раньше общего /media/*.
handle /media/backups/* {
	respond 403
}

handle /static/* {
	root * /srv
	file_server
}

handle /media/* {
	root * /srv
	# Пользовательские файлы отдаются inline (просмотрщик реквизитов,/),
	# поэтому нейтрализуем возможный stored XSS: CSP sandbox лишает любой
	# html/js-документ прав на исполнение скриптов и собственный origin, не
	# мешая показу изображений. nosniff — против MIME-подмены.
	#
	# Исключение — PDF: nosniff гарантирует, что .pdf отдаётся как
	# application/pdf и не может исполниться как html, поэтому sandbox для него
	# не нужен по безопасности, а вот встроенный PDF-просмотрщик Chrome он
	# ломает («Эта страница была заблокирована браузером Chrome»). Поэтому CSP
	# sandbox ставим всем, КРОМЕ *.pdf.
	@notpdf not path *.pdf
	header @notpdf Content-Security-Policy "sandbox"
	header X-Content-Type-Options "nosniff"
	file_server
}

handle {
	# B39/F6: CSP как защита в глубину для SPA-оболочки. Внешние origin'ы заперты
	# в аллоўлист реальных интеграций: Яндекс SmartCaptcha (единый хост
	# smartcaptcha.yandexcloud.net — и скрипт, и iframe, и его запросы) и Google
	# Fonts. Картинки — self/data/blob и любой https (файлы-реквизиты с S3
	# отдаются с домена провайдера, заранее неизвестного). worker/blob — для
	# PDF.js. object-src none, base-uri/frame-ancestors self — против внедрения
	# плагинов, <base>-хайджека и кликджекинга.
	#
	# script/style-src держат 'unsafe-inline': прод-сборка Vite инлайнит
	# модуль-preload-полифилл, а виджет капчи — свои inline-стили/скрипты; без
	# nonce на статике это неизбежно. Полноценный script-src без 'unsafe-inline'
	# (на nonce) — отдельная задача уровня сборки.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://smartcaptcha.yandexcloud.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://smartcaptcha.yandexcloud.net; frame-src 'self' https://smartcaptcha.yandexcloud.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
	reverse_proxy frontend:80
}
