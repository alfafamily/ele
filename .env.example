# Скопировать в .env и заполнить. .env не коммитится (см. .gitignore).
# Секреты живут только здесь, не в БД/интерфейсе. Приложение НИКОГДА не пишет в
# этот файл — мастер первичной настройки только читает уже заданные значения и
# тестирует подключение (S3/почта/капча/Яндекс ID). Если тест не проходит —
# поправьте .env и перезапустите `docker compose up -d` (переменные читаются
# один раз при старте контейнера).

# --- Django ---
DJANGO_SECRET_KEY=changeme-generate-a-real-random-secret-key
# Только для docker-compose.prod.yml (dev использует ALLOWED_HOSTS=["*"]):
DJANGO_ALLOWED_HOSTS=ele.example.com
CSRF_TRUSTED_ORIGINS=https://ele.example.com
# Публичный адрес инстанса (SPA и API на одном домене) — абсолютные ссылки в
# письмах, redirect_uri для Яндекс ID OAuth. В dev можно оставить как есть.
SITE_URL=http://localhost
DEFAULT_FROM_EMAIL=ELE <no-reply@ele.example.com>

# --- PostgreSQL ---
POSTGRES_USER=ele
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ele

# --- Caddy (только прод, docker-compose.prod.yml) ---
# Реальный домен — Caddy сам получит сертификат Let's Encrypt.
SITE_ADDRESS=ele.example.com

# --- Email (SMTP) ---
# В dev всегда используется mailpit, значения ниже не читаются. В проде —
# опционально: пусто = приложение стартует, но письма никуда не уходят (мастер
# первичной настройки предупредит и не даст пройти проверку почты).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Шифрование: порт 587 — STARTTLS (EMAIL_USE_TLS=true), порт 465 — implicit SSL
# (EMAIL_USE_SSL=true). Для порта 465 SSL включается автоматически, даже если
# EMAIL_USE_SSL не задан. Одновременно включать оба нельзя; если задан SSL, он
# имеет приоритет и TLS выключается автоматически.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Таймаут соединения с SMTP, сек (по умолчанию 10) — чтобы недоступный SMTP не
# «вешал» отправку писем, а быстро возвращал понятную ошибку.
EMAIL_TIMEOUT=10

# Первого администратора и компанию создаёт Setup Wizard в браузере при первом
# заходе — переменных для автосоздания админа из .env больше нет.

# --- Web Push (B44) ---
# Push-уведомления (ТО + подтверждение выдачи). Пусто = push выключен без ошибок
# (письма продолжают работать, кнопка включения push на устройстве недоступна).
# Новый инстанс: install.sh генерирует пару ключей сам и дописывает сюда.
# Обновление существующего инстанса (чтобы включить push): выполнить
#   docker compose -f docker-compose.prod.yml exec backend python manage.py generate_vapid_keys
# и вписать обе выведённые строки (VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY), затем up -d.
# VAPID_PRIVATE_KEY — секрет. VAPID_SUBJECT (контакт отправителя) по умолчанию =
# адрес инстанса (SITE_URL) — это валидный https-URI, который принимает и Apple
# (iOS/Safari-PWA), и FCM. Обычно менять не нужно; НЕ оставляйте пустым
# (`VAPID_SUBJECT=` = «», Apple отклонит), а либо не задавайте, либо укажите
# mailto с РЕАЛЬНЫМ доменом:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-company.com

# --- Хранилище файлов ---
# ELE_STORAGE_MODE=local | s3. Мастер первичной настройки показывает эти
# значения только для просмотра и тестирует подключение — ввода через UI нет.
ELE_STORAGE_MODE=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Объём бакета в ГБ (можно дробное, напр. 0.5) для индикации свободного места в
# «Настройки → Системные» (у S3 нет понятия «свободно» — лимит задаёте вы).
# Пусто/0 = лимит не задан, тогда показывается только занятый объём без
# предупреждения о нехватке.
S3_QUOTA_GB=
# Тайм-ауты клиента S3 для media, в секундах (можно дробное). Относятся к каналу
# backend↔S3 (внутри ДЦ), НЕ к скорости пользователя. Пусто = значения по
# умолчанию 5/60. connect — установка соединения; read — лимит на одну
# socket-операцию, НЕ на весь перенос файла (большую загрузку не обрывает).
# Поднимайте только для медленного/удалённого/нестабильного S3.
S3_CONNECT_TIMEOUT=
S3_READ_TIMEOUT=

# --- Резервный S3 для полных бэкапов (B29) ---
# ОТДЕЛЬНОЕ независимое S3-хранилище: полная копия (БД + файлы) уезжает сюда,
# чтобы пережить потерю/компрометацию основного сервера. Пусто = выгрузка на
# резервный S3 недоступна (копии остаются только в своём хранилище).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Объём резервного бакета в ГБ (можно дробное; как S3_QUOTA_GB, но для
# backup-S3). Пусто/0 = лимит не задан.
BACKUP_S3_QUOTA_GB=
# Парольная фраза шифрования АВТО-копий (cron). Пусто = авто-копии не шифруются.
# Ручные копии можно шифровать паролем прямо в интерфейсе.
BACKUP_PASSPHRASE=

# --- Яндекс SmartCaptcha ---
# Пусто = капча выключена, лимит попыток + блокировка продолжают работать.
YANDEX_SMARTCAPTCHA_SITE_KEY=
YANDEX_SMARTCAPTCHA_SECRET_KEY=

# --- Яндекс ID OAuth ---
# Пусто = кнопка "Войти через Яндекс ID" не отображается.
YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=
